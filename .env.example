NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production
ADMIN_EMAIL=admin@hayanest.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional Supabase hybrid persistence
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Haya Nest <orders@your-domain.com>
RESEND_API_KEY=

# Optional Steadfast environment fallback
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
